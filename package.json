{
	"name": "eventsourcingdb-merkle",
	"version": "1.1.2",
	"description": "Merkle tree utilities for EventSourcingDB backups.",
	"author": {
		"name": "the native web GmbH",
		"email": "hello@thenativeweb.io"
	},
	"bin": "./dist/index.js",
	"type": "module",
	"files": ["dist"],
	"oclif": {
		"bin": "eventsourcingdb-merkle",
		"dirname": "eventsourcingdb-merkle",
		"commands": "./dist/commands"
	},
	"dependencies": {
		"@oclif/core": "4.11.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "26.1.1",
		"tsx": "4.23.0",
		"typescript": "7.0.2"
	},
	"scripts": {
		"analyze": "npx tsc --noEmit && npx biome check --error-on-warnings .",
		"build": "npx tsc -p tsconfig.build.json",
		"format": "npx biome check --write .",
		"qa": "npm run analyze && npm run test",
		"test": "npm run build && node --test --import tsx \"./src/**/*.test.ts\""
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/thenativeweb/eventsourcingdb-merkle.git"
	},
	"license": "MIT",
	"keywords": [
		"eventsourcingdb",
		"esdb",
		"merkle",
		"merkle-tree",
		"backup",
		"verification"
	]
}
